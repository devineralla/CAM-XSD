<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="GETACCOUNTDETAILS">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="MSISDN">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\S.*"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="COUNTRY"
                    type="xs:string"
                    minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
